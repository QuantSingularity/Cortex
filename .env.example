# ─── Cortex MLOps Backbone ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_secret
POSTGRES_DB=cortex
DATABASE_URL=postgresql://cortex:cortex_secret@postgres:5432/cortex

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_FEATURE_TOPIC=cortex.features
KAFKA_DRIFT_TOPIC=cortex.drift

# Service URLs (internal)
FEATURE_STORE_URL=http://feature-store:8001
MODEL_REGISTRY_URL=http://model-registry:8002
SERVING_URL=http://serving:8003
DRIFT_DETECTION_URL=http://drift-detection:8004
SCHEDULER_URL=http://scheduler:8005

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-32-chars
